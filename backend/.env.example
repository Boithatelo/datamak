PORT=4000
JWT_SECRET=change_this_in_production
# Copy this file to backend/.env for local development.
# For Vercel + Neon, set these values in the Vercel dashboard instead.

DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/datamak_ecommerce
PG_SSL=false
PG_POOL_MAX=10
DB_CREATE_DATABASE=true

# Local filesystem uploads are fine for development.
ENABLE_LOCAL_UPLOADS=true

# Vercel + Neon example. Prefer the pooled connection string from the
# Neon/Vercel Marketplace integration:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require
# PG_SSL=true
# PG_POOL_MAX=1
# DB_CREATE_DATABASE=false
# ENABLE_LOCAL_UPLOADS=false
