{
  "name": "group-project-2026-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "cypress:run:headed": "cypress run --headed --browser chrome",
    "cypress:run:report": "cypress run --reporter junit --reporter-options mochaFile=cypress/artifacts/reports/junit-[hash].xml,toConsole=true",
    "cy:open": "set ELECTRON_RUN_AS_NODE=&&set CYPRESS_CACHE_FOLDER=.cypress-cache&&set CYPRESS_SKIP_VERIFY=true&&cypress open",
    "cy:run": "set ELECTRON_RUN_AS_NODE=&&set CYPRESS_CACHE_FOLDER=.cypress-cache&&set CYPRESS_SKIP_VERIFY=true&&cypress run --browser electron",
    "test:e2e": "npm run test:e2e:playwright",
    "test:e2e:cypress": "npm run cypress:run",
    "test:e2e:screenshots": "npm run cy:run",
    "test:e2e:playwright": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:chrome": "playwright test --project=chrome --headed --workers=1",
    "test:e2e:edge": "playwright test --project=edge --headed --workers=1",
    "test:e2e:firefox": "playwright test --project=firefox --headed --workers=1",
    "test:e2e:demo:chrome": "set PLAYWRIGHT_SLOWMO=900&& set PLAYWRIGHT_DEMO=1&& playwright test --project=chrome --headed --workers=1",
    "test:e2e:demo:edge": "set PLAYWRIGHT_SLOWMO=900&& set PLAYWRIGHT_DEMO=1&& playwright test --project=edge --headed --workers=1",
    "test:e2e:demo:firefox": "set PLAYWRIGHT_SLOWMO=900&& set PLAYWRIGHT_DEMO=1&& playwright test --project=firefox --headed --workers=1",
    "test:e2e:report": "playwright show-report",
    "test:e2e:install": "playwright install",
    "test": "vitest --run --reporter verbose"
  },
  "dependencies": {
    "axios": "^1.7.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^4.3.2",
    "cypress": "^13.15.2",
    "jsdom": "^29.1.1",
    "vite": "^5.4.10",
    "vitest": "^4.1.7"
  }
}
