        {
          "id": "c25",
          "comment": "",
          "command": "waitForText",
          "target": "css=.catalog-sort-trigger small",
          "targets": [],
          "value": "Best Discount"
        },
        {
          "id": "c26",
          "comment": "",
          "command": "waitForElementVisible",
          "target": "css=.product-card",
          "targets": [],
          "value": "15000"
        }
      ]
    },
    {
