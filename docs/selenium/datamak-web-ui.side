{
  "id": "7d8bb0b4-6af8-4b52-8f14-datamakwebui",
  "version": "2.0",
  "name": "Datamak Web UI Selenium Tests",
  "url": "http://localhost:5173",
  "tests": [
    {
      "id": "f7dff5de-d1e9-4bb9-8579-loggedoutcart",
      "name": "Logged-out add to cart shows login dialog",
      "commands": [
        {
          "id": "c1",
          "comment": "Start from logged-out state.",
          "command": "open",
          "target": "/catalog?category=Computers",
          "targets": [],
          "value": ""
        },
        {
          "id": "c2",
          "comment": "",
          "command": "executeScript",
          "target": "window.localStorage.clear(); window.sessionStorage.clear();",
          "targets": [],
          "value": ""
        },
        {
          "id": "c3",
          "comment": "",
          "command": "open",
          "target": "/catalog?category=Computers",
          "targets": [],
          "value": ""
        },
        {
          "id": "c4",
          "comment": "",
          "command": "setWindowSize",
          "target": "1366x768",
          "targets": [],
          "value": ""
        },
        {
          "id": "c5",
          "comment": "",
          "command": "waitForElementVisible",
          "target": "xpath=(//button[contains(normalize-space(.),'Add to Cart')])[1]",
          "targets": [],
          "value": "15000"
        },
        {
          "id": "c6",
          "comment": "",
          "command": "click",
          "target": "xpath=(//button[contains(normalize-space(.),'Add to Cart')])[1]",
          "targets": [],
          "value": ""
        },
        {
          "id": "c7",
          "comment": "",
          "command": "waitForElementVisible",
          "target": "css=.message-dialog",
          "targets": [],
          "value": "10000"
        },
        {
          "id": "c8",
          "comment": "",
          "command": "assertText",
          "target": "css=.message-dialog h2",
          "targets": [],
          "value": "Login Required"
        },
        {
          "id": "c9",
          "comment": "",
          "command": "assertText",
          "target": "css=.message-dialog p",
          "targets": [],
          "value": "Please login or register to add products to cart."
        },
        {
          "id": "c10",
          "comment": "",
          "command": "click",
          "target": "xpath=//button[normalize-space()='OK']",
          "targets": [],
          "value": ""
        }
      ]
    },
    {
      "id": "c2153cf7-1d4d-4748-8e8a-customerlogin",
      "name": "Customer login works",
      "commands": [
        {
          "id": "c11",
          "comment": "",
          "command": "open",
          "target": "/auth",
          "targets": [],
          "value": ""
        },
        {
          "id": "c12",
          "comment": "",
          "command": "executeScript",
          "target": "window.localStorage.clear(); window.sessionStorage.clear();",
          "targets": [],
          "value": ""
        },
        {
          "id": "c13",
          "comment": "",
          "command": "open",
          "target": "/auth",
          "targets": [],
          "value": ""
        },
        {
          "id": "c14",
          "comment": "",
          "command": "waitForElementVisible",
          "target": "css=input[name='email']",
          "targets": [],
          "value": "10000"
        },
        {
          "id": "c15",
          "comment": "",
          "command": "type",
          "target": "css=input[name='email']",
          "targets": [],
          "value": "customer@datamak.local"
        },
        {
          "id": "c16",
          "comment": "",
          "command": "type",
          "target": "css=input[name='password']",
          "targets": [],
          "value": "Customer@123"
        },
        {
          "id": "c17",
          "comment": "",
          "command": "click",
          "target": "css=.auth-submit",
          "targets": [],
          "value": ""
        },
        {
          "id": "c18",
          "comment": "",
          "command": "waitForElementVisible",
          "target": "xpath=//a[normalize-space()='Hi, Sample Customer']",
          "targets": [],
          "value": "15000"
        },
        {
          "id": "c19",
          "comment": "",
          "command": "assertText",
          "target": "xpath=//a[normalize-space()='Hi, Sample Customer']",
          "targets": [],
          "value": "Hi, Sample Customer"
        }
      ]
    },
    {
      "id": "de33f567-835e-4b46-8b2f-catalogsort",
