              "mode": "raw",
              "raw": "{\n  \"productId\": \"{{checkoutProductId}}\",\n  \"quantity\": 1\n}"
            },
            "url": "{{baseUrl}}/cart/items"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "Checkout With Simulated Payment",
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{customerToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"paymentMethod\": \"Simulated Card\",\n  \"shippingAddress\": \"Test Address, Maseru\",\n  \"billingAddress\": \"Test Address, Maseru\",\n  \"couponCode\": \"HOST20\"\n}"
            },
            "url": "{{baseUrl}}/checkout"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "const data = pm.response.json();",
                  "pm.test('Simulated payment approved', () => pm.expect(data.order.payment.simulated).to.eql(true));",
                  "pm.test('Order status is Paid', () => pm.expect(data.order.status).to.eql('Paid'));",
                  "pm.environment.set('orderId', data.order.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Customer Orders",
