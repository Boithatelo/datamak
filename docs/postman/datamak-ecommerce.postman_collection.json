          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const orders = pm.response.json().orders || [];",
                  "pm.test('Order list returned', () => pm.expect(orders.length).to.be.above(0));"
                ]
              }
            }
          ]
        },
        {
          "name": "Customer Order Details",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{customerToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [],
            "url": "{{baseUrl}}/orders/{{orderId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const order = pm.response.json().order;",
                  "pm.test('Correct order returned', () => pm.expect(order.id).to.eql(pm.environment.get('orderId')));",
                  "pm.test('Status history exists', () => pm.expect(order.statusHistory.length).to.be.above(0));"
                ]
              }
