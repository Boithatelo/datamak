    },
    {
      "name": "02 Products",
      "item": [
        {
          "name": "Product Categories Metadata",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/products/meta/categories"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const data = pm.response.json();",
                  "pm.test('Expected categories exist', () => {",
                  "  pm.expect(data.categories).to.include('Computers');",
                  "  pm.expect(data.categories).to.include('ICT Products');",
                  "  pm.expect(data.categories).to.include('Web Hosting Services');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Product Catalog List",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/products?pageSize=60"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const data = pm.response.json();",
                  "const products = data.products || [];",
                  "pm.test('Products returned', () => pm.expect(products.length).to.be.above(0));",
                  "pm.test('No remote product images', () => {",
                  "  const remote = products.filter((product) => /^https?:\\/\\//.test(product.imageUrl || '') || (product.gallery || []).some((image) => /^https?:\\/\\//.test(image || '')));",
                  "  pm.expect(remote.length).to.eql(0);",
                  "});",
                  "const physical = products.find((product) => product.type !== 'service' && Number(product.stock || 0) > 0) || products[0];",
                  "const service = products.find((product) => product.type === 'service') || products[0];",
                  "pm.environment.set('productId', physical.id);",
                  "pm.environment.set('checkoutProductId', service.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Computer Category Filter",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/products?pageSize=60&category=Computers"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const products = pm.response.json().products || [];",
                  "pm.test('Only computers returned', () => pm.expect(products.every((product) => product.category === 'Computers')).to.eql(true));"
                ]
              }
            }
          ]
        },
        {
          "name": "Price Ascending Sort",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/products?pageSize=60&sort=price_asc"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const products = pm.response.json().products || [];",
                  "pm.test('Prices sorted ascending', () => {",
                  "  for (let index = 1; index < products.length; index += 1) {",
                  "    pm.expect(Number(products[index - 1].price)).to.be.at.most(Number(products[index].price));",
                  "  }",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Product Details",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/products/{{productId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const data = pm.response.json();",
                  "pm.test('Product details returned', () => pm.expect(data.product.id).to.eql(pm.environment.get('productId')));",
                  "pm.test('Related products array returned', () => pm.expect(data.related).to.be.an('array'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "03 Cart",
      "item": [
        {
          "name": "Clear Customer Cart",
          "request": {
            "method": "DELETE",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{customerToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [],
            "url": "{{baseUrl}}/cart"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Cart is empty', () => pm.expect(pm.response.json().cart.items.length).to.eql(0));"
                ]
              }
            }
          ]
        },
        {
          "name": "Add Product To Cart",
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{customerToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": \"{{productId}}\",\n  \"quantity\": 1\n}"
            },
            "url": "{{baseUrl}}/cart/items"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "const items = pm.response.json().cart.items || [];",
                  "pm.test('Item exists in cart', () => pm.expect(items.some((item) => item.productId === pm.environment.get('productId'))).to.eql(true));"
                ]
              }
            }
          ]
        },
        {
          "name": "Update Cart Quantity",
          "request": {
            "method": "PUT",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{customerToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantity\": 2\n}"
            },
            "url": "{{baseUrl}}/cart/items/{{productId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const item = (pm.response.json().cart.items || []).find((entry) => entry.productId === pm.environment.get('productId'));",
                  "pm.test('Quantity updated to 2', () => pm.expect(item.quantity).to.eql(2));"
                ]
              }
            }
          ]
        },
        {
          "name": "Remove Product From Cart",
          "request": {
            "method": "DELETE",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{customerToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [],
            "url": "{{baseUrl}}/cart/items/{{productId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const items = pm.response.json().cart.items || [];",
                  "pm.test('Item removed from cart', () => pm.expect(items.some((item) => item.productId === pm.environment.get('productId'))).to.eql(false));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "04 Checkout and Orders",
      "item": [
        {
          "name": "Add Hosting Service For Checkout",
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{customerToken}}",
